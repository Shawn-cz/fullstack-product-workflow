#!/usr/bin/env node
/**
 * 软件产品设计与全栈交付工作流 v1.3.1 — 跨平台本地 Git Pre-commit 前置卡点 (STD-CODE-12 / STD-GOV-05 / STD-QA-13)
 * 采用纯 Node.js 执行，避免 Windows CRLF 或 /bin/sh + find 兼容性报错。
 * 启用命令：npm run hooks:install（执行 git config core.hooksPath .githooks）
 */
import { spawnSync } from 'node:child_process'
import fs from 'node:fs'

function runOrExit(cmd, args) {
  const res = spawnSync(cmd, args, { stdio: 'inherit' })
  if (res.status !== 0) {
    process.exit(res.status || 1)
  }
}

console.log('🛡️ [Pre-commit] 正在执行跨平台本地前置门禁检查...')

// 1. 自动刷新项目资产语义索引树并一并暂存
if (fs.existsSync('scripts/build-index-tree.mjs')) {
  runOrExit(process.execPath, ['scripts/build-index-tree.mjs', '--write'])
  if (fs.existsSync('PROJECT_INDEX_TREE.md')) {
    runOrExit('git', ['add', 'PROJECT_INDEX_TREE.md'])
  }
  if (fs.existsSync('docs/index-tree.json')) {
    runOrExit('git', ['add', 'docs/index-tree.json'])
  }
}

// 2. 运行 Gate 2（静态基线防呆）与 Gate 1（双向 REQ/AC 覆盖、禁 SQLite 与索引树新鲜度；S0 空底座自动豁免测试数）
if (fs.existsSync('scripts/verify-gates.mjs')) {
  runOrExit(process.execPath, ['scripts/verify-gates.mjs', '--gate=2'])
  runOrExit(process.execPath, ['scripts/verify-gates.mjs', '--gate=1'])
}

console.log('✅ [Pre-commit] 本地前置门禁全部通过，允许提交。')
