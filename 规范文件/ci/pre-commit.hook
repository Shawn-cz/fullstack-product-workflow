#!/bin/sh
# 软件产品设计与全栈交付工作流 v1.3.0 — 本地 Git Pre-commit 强制前置卡点 (STD-CODE-12 / STD-GOV-05 / STD-QA-13)
# 启用命令：npm run hooks:install（执行 git config core.hooksPath .githooks）

set -e

echo "🛡️ [Pre-commit] 正在执行本地前置门禁检查..."

# 1. 自动刷新项目资产语义索引树并一并暂存（防止忘记刷新导致 Push 后 CI Gate 1 变红）
if [ -f "scripts/build-index-tree.mjs" ]; then
  node scripts/build-index-tree.mjs --write
  if [ -f "PROJECT_INDEX_TREE.md" ]; then
    git add PROJECT_INDEX_TREE.md
  fi
  if [ -f "docs/index-tree.json" ]; then
    git add docs/index-tree.json
  fi
fi

# 2. 运行 Gate 2（防作弊、安全红线、前端禁 node:crypto / localStorage 存令牌、禁用旧栈）
if [ -f "scripts/verify-gates.mjs" ]; then
  node scripts/verify-gates.mjs --gate=2

  # 若项目中已有测试文件，同步校验 Gate 1（双向 REQ/AC 覆盖、禁用 SQLite 与索引树新鲜度）
  if [ -d "tests" ] && [ -n "$(find tests -maxdepth 4 \( -name '*.test.ts' -o -name '*.test.tsx' -o -name '*.spec.ts' -o -name '*.spec.tsx' \) 2>/dev/null)" ]; then
    node scripts/verify-gates.mjs --gate=1
  fi
fi

echo "✅ [Pre-commit] 本地前置门禁全部通过，允许提交。"
