{
  "name": "team-fullstack-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "start": "node dist-server/index.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit && eslint . && npx prisma validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:fresh": "npm run db:reset && npx playwright test",
    "test:e2e:report": "npx playwright show-report docs/evidence/playwright-report",
    "db:up": "docker compose -f docker-compose.postgres.yml up -d",
    "db:down": "docker compose -f docker-compose.postgres.yml down",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "npx prisma migrate reset --force && npm run db:seed",
    "db:studio": "npx prisma studio",
    "db:backup": "node scripts/backup-postgres.mjs --backup",
    "index:build": "node scripts/build-index-tree.mjs --write",
    "gates": "node scripts/verify-gates.mjs --all",
    "gates:lock": "node scripts/verify-gates.mjs --gate=4 --lock",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "node -e \"import('node:fs').then(f=>f.existsSync('.git')&&import('node:child_process').then(c=>c.spawnSync('git',['config','core.hooksPath','.githooks'],{stdio:'ignore'})))\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@prisma/client": "^6.0.0",
    "@tanstack/react-query": "^5.60.0",
    "hono": "^4.6.0",
    "pino": "^9.5.0",
    "preline": "^3.0.0",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
